{
  "rules": {
    "rooms": {
      "$room": {
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && ($room === 'arena-1' || $room.matches(/^COIL-[A-Z0-9]{4}$/))",
            ".validate": "newData.hasChildren(['n', 's', 'b', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 16 && newData.child('s').isNumber() && newData.child('s').val() >= 0 && newData.child('s').val() <= 100000 && newData.child('t').isNumber() && (!newData.child('dv').exists() || root.child('devs').child(auth.uid).val() === true)"
          }
        },
        "kills": {
          ".read": "auth != null",
          ".indexOn": [
            "k"
          ],
          "$kill": {
            ".write": "auth != null && ((!data.exists() && newData.child('v').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('k').val() === auth.uid))",
            ".validate": "newData.hasChildren(['k', 'v', 't']) && newData.child('k').isString() && newData.child('t').isNumber()"
          }
        },
        "food": {
          ".read": "auth != null",
          "$slot": {
            ".write": "auth != null && ($room === 'arena-1' || $room.matches(/^COIL-[A-Z0-9]{4}$/))",
            ".validate": "$slot.matches(/^[0-9]{1,3}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        },
        "drops": {
          ".read": "auth != null",
          "$drop": {
            ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid && ($room === 'arena-1' || $room.matches(/^COIL-[A-Z0-9]{4}$/))) || (data.exists() && !newData.exists() && (data.child('u').val() === auth.uid || data.child('t').val() < now - 40000)))",
            ".validate": "newData.hasChildren(['u', 't', 'p', 'v']) && newData.child('v').isNumber() && newData.child('v').val() >= 1 && newData.child('v').val() <= 20",
            "e": {
              "$k": {
                ".write": "auth != null && !data.exists() && newData.val() === 1"
              }
            }
          }
        }
      }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": [
        "score"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('devs').child(auth.uid).val() !== true)",
        ".validate": "newData.hasChildren(['name', 'score', 't']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16 && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 50000 && (!data.exists() || newData.child('score').val() >= data.child('score').val())"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber()"
      }
    },
    "devs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "weekly": {
      "$week": {
        ".read": true,
        ".indexOn": [
          "score"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('devs').child(auth.uid).val() !== true) && $week.matches(/^[0-9]{4}-W[0-9]{2}$/)",
          ".validate": "newData.hasChildren(['name', 'score', 't']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16 && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 50000 && (!data.exists() || newData.child('score').val() >= data.child('score').val())"
        }
      }
    },
    "publicProfiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 16"
      }
    },
    "whereabouts": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "friendCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/)"
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && $from !== $to && (auth.uid === $from || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['n', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 16"
        }
      }
    },
    "friends": {
      "$u": {
        ".read": "auth != null && auth.uid === $u",
        "$f": {
          ".write": "auth != null && (auth.uid === $u || (auth.uid === $f && (!newData.exists() || root.child('friendRequests').child($f).child($u).exists())))",
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}